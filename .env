# --- 資料庫設定 (PostgreSQL) ---
# 這些設定會被 Docker 的 db 容器與 Django 應用程式共同使用
POSTGRES_DB=peereval
POSTGRES_USER=peereval_user
POSTGRES_PASSWORD=password
DB_HOST=db
DB_PORT=5432

# --- Django 核心設定 ---
SECRET_KEY=django-insecure-your-unique-secret-key-here

# 開發環境設為 True，正式上線建議設為 False
DEBUG=True

# 允許存取的網域，多個網域用逗號隔開
ALLOWED_HOSTS=localhost,127.0.0.1

INST_NAME="Purdue University"
INST_SHORT_NAME="Purdue"
TIME_ZONE=America/Indiana/Indianapolis

# --- 整合功能 ---
# 是否啟用 Brightspace (LMS) 整合功能
ENABLE_BRIGHTSPACE=True



EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=pcw.pu.test@gmail.com
EMAIL_HOST_PASSWORD=wdym qeok vrfe echw
EMAIL_USE_TLS=True